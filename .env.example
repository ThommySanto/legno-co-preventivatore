# Copiare in .env.local. Nessuna chiave segreta va nel browser o in Git.
# local = file JSON; supabase = database reale, senza ripiego sul file locale.
VITE_CATALOG_SOURCE=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo server Vercel: non usare il prefisso VITE_ e non inserire mai la chiave nel browser.
ANTHROPIC_API_KEY=
